# --- Banco ---
POSTGRES_USER=lembrete
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lembrete
DATABASE_URL=postgres://lembrete:troque-esta-senha@postgres:5432/lembrete

# --- App ---
APP_URL=https://app.seudominio.com.br
DOMAIN=app.seudominio.com.br
# gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Login de desenvolvimento (sem senha, so e-mail). NUNCA ligar em producao.
# Substituir por Auth.js/Better Auth (Google + magic link) na semana 1.
AUTH_DEV_LOGIN=true

# --- E-mail (Resend). Sem chave, o worker apenas imprime no log ---
RESEND_API_KEY=
EMAIL_FROM=Lembrete <nao-responda@seudominio.com.br>

# --- Fase seguinte ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# So para testes locais: envia e-mails fora da janela seg-sab 8h-18h. NUNCA em producao.
# IGNORE_SEND_WINDOW=true
